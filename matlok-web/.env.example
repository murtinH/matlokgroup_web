# Šablona proměnných prostředí pro lokální vývoj.
#
# Veřejné identifikátory Sanity tady nejsou — jsou v src/lib/konfigurace.ts,
# odkud je čte build i serverový skript. Web se tedy postaví i bez tohohle
# souboru; potřebuješ ho jen na to, co je tajné.
#
# Zkopíruj na .dev.vars (pro `npm run cf:dev`). Ten je v .gitignore
# a do repozitáře se nedostane. V ostrém provozu se hodnoty vkládají
# v Cloudflare jako šifrované proměnné, nikam jinam.

# --- Zápis poptávek do Sanity (role Editor) ---
SANITY_WRITE_TOKEN=

# --- Odesílání notifikací ---
# Adresa příjemce se nebere odsud, ale z pole notifikacniEmail v Sanity.
RESEND_API_KEY=

# --- MůjAutomat Partner API (Session 5) ---
# Klíč má oprávnění partner:write — umí zakládat i rušit objednávky.
MUJAUTOMAT_API_KEY=
MUJAUTOMAT_MACHINE_ID=
