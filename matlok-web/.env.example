# Šablona proměnných prostředí. Zkopíruj na .env.local pro lokální vývoj.
# .env.local je v .gitignore a NIKDY se necommituje.
#
# Ostrý provoz: hodnoty se vkládají jako šifrované proměnné
# v Cloudflare Pages → Settings → Environment variables.
# Do repozitáře se skutečné klíče nepíšou. Nikdy.

# --- Sanity (veřejné, smí do klientského kódu) ---
PUBLIC_SANITY_PROJECT_ID=jew7wcoq
PUBLIC_SANITY_DATASET=production

# --- Sanity zápis (Session 4, POUZE serverově) ---
SANITY_WRITE_TOKEN=

# --- Odesílání notifikací (Session 4, POUZE serverově) ---
# Adresa příjemce se nebere odsud, ale z pole notifikacniEmail v Sanity.
RESEND_API_KEY=

# --- MůjAutomat Partner API (Session 5, POUZE serverově) ---
# Klíč má oprávnění partner:write — umí zakládat i rušit objednávky.
MUJAUTOMAT_API_KEY=
MUJAUTOMAT_MACHINE_ID=
