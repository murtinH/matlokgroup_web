---
/**
 * Ikony pro karty výhod. Kreslené jsou tady, ne v Sanity — jsou to
 * grafické prvky, ne obsah. V Sanity je uložený jen klíč ikony.
 */
interface Props {
  jmeno: string
}

const {jmeno} = Astro.props

const cesty: Record<string, string> = {
  hodiny: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
  stit: '<path d="M12 3l7 3v6c0 4.2-2.9 7.6-7 9-4.1-1.4-7-4.8-7-9V6l7-3z"/><path d="m9 12 2 2 4-4"/>',
  posuvniky: '<path d="M4 21v-7M4 10V3M12 21v-9M12 8V3M20 21v-5M20 12V3"/><path d="M1 14h6M9 8h6M17 16h6"/>',
  karta: '<rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/>',
  obnoveni: '<path d="M21 12a9 9 0 1 1-3-6.7"/><path d="M21 3v6h-6"/>',
  retez:
    '<path d="m15.5 7.5 3-3a3.5 3.5 0 0 1 5 5l-3 3"/><path d="m8.5 16.5-3 3a3.5 3.5 0 0 1-5-5l3-3"/><path d="M8 16 16 8"/>',

  // Služby Digital Services
  web: '<rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/>',
  foto: '<path d="M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3z"/><circle cx="12" cy="13" r="3.5"/>',
  social:
    '<path d="M21 11.5a8.4 8.4 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.4 8.4 0 0 1-3.8-.9L3 21l1.9-5.7a8.4 8.4 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.4 8.4 0 0 1 3.8-.9h.5a8.5 8.5 0 0 1 8 8v.5z"/>',
  video: '<path d="m22 8-6 4 6 4V8z"/><rect x="2" y="6" width="14" height="12" rx="2"/>',
  reklama: '<path d="M3 3v18h18"/><path d="m19 9-5 5-4-4-3 3"/>',
  konzultace: '<path d="M12 3a6 6 0 0 0-4 10.5V17h8v-3.5A6 6 0 0 0 12 3z"/><path d="M9 21h6"/>',

  // Proč Matlok
  provoz: '<path d="M3 7.5 12 3l9 4.5v9L12 21l-9-4.5z"/><path d="M3 7.5 12 12l9-4.5M12 12v9"/>',
  rychlost: '<path d="M13 2 4.5 13H11l-1 9 8.5-11H12z"/>',
  trvanlivost: '<path d="M12 3l7 3v6c0 4.2-2.9 7.6-7 9-4.1-1.4-7-4.8-7-9V6l7-3z"/><path d="m9 12 2 2 4-4"/>',
}

const cesta = cesty[jmeno]
---

{
  cesta && (
    <svg
      width="20"
      height="20"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      set:html={cesta}
    />
  )
}
