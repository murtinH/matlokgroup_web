---
/**
 * Prodejní box ve dřevěném přístřešku. Kreslené, ne vyfocené —
 * fotka konkrétního stroje na stránku podle zadání nepatří.
 *
 * Používá výhradně barvy z palety. Dřevo je ve studené neutrální řadě,
 * protože hnědá v paletě není a zavádět ji nesmíme; přístřešek se pozná
 * podle tvaru, ne podle barvy.
 */

// Řady zboží za sklem. Barvy se střídají podle vzoru, aby výplň
// vypadala jako sortiment a ne jako tapeta.
const PALETA = ['var(--azure-400)', 'var(--azure-200)', 'var(--neutral-300)', 'var(--red-400)', 'var(--azure-500)']
const rady = [0, 1, 2, 3, 4].map((r) =>
  [0, 1, 2, 3, 4, 5].map((s) => ({
    x: 148 + s * 43,
    y: 224 + r * 52,
    barva: PALETA[(r * 3 + s * 2) % PALETA.length],
    vysoke: (r + s) % 3 === 0,
  })),
)
---

<svg
  class="ilustrace"
  viewBox="0 0 560 700"
  role="img"
  aria-label="Samoobslužný prodejní box Matlok ve dřevěném přístřešku"
  xmlns="http://www.w3.org/2000/svg"
>
  <!-- přístřešek: zadní stěna z prken -->
  <rect x="92" y="96" width="392" height="536" rx="6" fill="var(--neutral-200)" />
  {
    [0, 1, 2, 3, 4, 5, 6, 7].map((i) => (
      <line
        x1="92"
        y1={124 + i * 64}
        x2="484"
        y2={124 + i * 64}
        stroke="var(--neutral-300)"
        stroke-width="2"
      />
    ))
  }

  <!-- stříška -->
  <path d="M64 104 L296 40 L528 104 L528 128 L296 66 L64 128 Z" fill="var(--neutral-400)" />
  <path d="M64 104 L296 40 L528 104 L296 66 Z" fill="var(--neutral-300)" />

  <!-- sloupky -->
  <rect x="64" y="118" width="22" height="524" rx="4" fill="var(--neutral-400)" />
  <rect x="506" y="118" width="22" height="524" rx="4" fill="var(--neutral-400)" />

  <!-- tělo automatu -->
  <rect x="118" y="152" width="340" height="470" rx="10" fill="var(--ink-800)" />

  <!-- sklo s nabídkou -->
  <rect x="134" y="168" width="230" height="330" rx="6" fill="var(--ink-700)" />
  {
    rady.flat().map((z) => (
      <rect
        x={z.x}
        y={z.vysoke ? z.y - 8 : z.y}
        width="30"
        height={z.vysoke ? 40 : 32}
        rx="4"
        fill={z.barva}
        opacity="0.92"
      />
    ))
  }
  <!-- police -->
  {
    [0, 1, 2, 3, 4].map((r) => (
      <line
        x1="140"
        y1={264 + r * 52}
        x2="358"
        y2={264 + r * 52}
        stroke="var(--ink-600)"
        stroke-width="3"
      />
    ))
  }

  <!-- ovládací sloupec -->
  <rect x="378" y="168" width="64" height="330" rx="6" fill="var(--ink-900)" />
  <!-- platební terminál -->
  <rect x="390" y="256" width="40" height="54" rx="6" fill="var(--ink-700)" />
  <rect x="398" y="268" width="24" height="16" rx="3" fill="var(--azure-500)" />
  <circle class="ilustrace__dioda" cx="410" cy="296" r="4" fill="var(--green-500)" />
  <!-- štítek provozovatele -->
  <rect x="388" y="184" width="44" height="8" rx="2" fill="var(--neutral-500)" />
  <rect x="388" y="198" width="32" height="6" rx="2" fill="var(--neutral-600)" />

  <!-- výdejní schránka -->
  <rect x="134" y="516" width="308" height="90" rx="8" fill="var(--neutral-0)" />
  <rect x="196" y="540" width="184" height="42" rx="6" fill="var(--ink-800)" />
  <rect x="206" y="550" width="164" height="22" rx="3" fill="var(--ink-700)" />

  <!-- azurový čtverec: značkový motiv -->
  <rect x="414" y="576" width="28" height="28" fill="var(--accent)" />

  <!-- zem -->
  <line x1="40" y1="642" x2="552" y2="642" stroke="var(--neutral-300)" stroke-width="3" />
</svg>

<style>
  .ilustrace {
    width: 100%;
    height: auto;
    max-height: clamp(320px, 44vw, 520px);
    display: block;
  }

  /* Dioda na terminálu bliká jako u živé karty — drobnost, která
     napoví, že box je v provozu. */
  .ilustrace__dioda {
    animation: ilustrace-tep 2.4s var(--ease-out) infinite;
  }
  @keyframes ilustrace-tep {
    0%, 100% { opacity: 1; }
    55% { opacity: 0.25; }
  }
  @media (prefers-reduced-motion: reduce) {
    .ilustrace__dioda { animation: none; }
  }
</style>
