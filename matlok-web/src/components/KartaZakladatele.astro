---
import {obrazek, srcset} from '../lib/sanity'
import type {Founder} from '../lib/queries'

interface Props {
  zakladatel: Founder
}

const {zakladatel} = Astro.props

// Dokud fotka není v Sanity, ukáže se monogram — stejně jako v prototypu.
const monogram = zakladatel.jmeno
  .split(' ')
  .filter((c) => /^[A-ZÁ-Ž]/.test(c))
  .slice(0, 2)
  .map((c) => c[0])
  .join('')
---

<article class="fcard reveal">
  <div class="fcard__head">
    <div class="fcard__av">
      {
        zakladatel.foto ? (
          <img
            src={obrazek(zakladatel.foto).width(112).height(112).fit('crop').url()}
            srcset={srcset(zakladatel.foto, [56, 112, 168])}
            sizes="56px"
            width="56"
            height="56"
            alt={zakladatel.jmeno}
          />
        ) : (
          monogram
        )
      }
    </div>
    <div>
      <div class="fcard__role">{zakladatel.role}</div>
      <div class="fcard__name">{zakladatel.jmeno}</div>
    </div>
  </div>

  <div class="fcard__claim">{zakladatel.claim}</div>
  <p>{zakladatel.bio}</p>
  {zakladatel.lidskyDetail && <div class="fcard__human">{zakladatel.lidskyDetail}</div>}

  {
    zakladatel.stitky && zakladatel.stitky.length > 0 && (
      <div class="tags">
        {zakladatel.stitky.map((stitek) => (
          <span class="tag">{stitek}</span>
        ))}
      </div>
    )
  }
</article>
