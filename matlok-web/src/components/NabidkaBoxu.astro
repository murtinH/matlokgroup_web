---
import type {MatlokPage, Product} from '../lib/queries'

interface Props {
  obsah: MatlokPage
  produkty: Product[]
}

const {obsah, produkty} = Astro.props
const hranice = obsah.hranicePoslednichKusu ?? 3

/**
 * Kolik položek je vidět, než návštěvník rozbalí zbytek.
 *
 * Automat vydává skoro čtyřicet druhů zboží a celý seznam naráz udělal
 * z nabídky nekonečný sloupec, hlavně na telefonu. Dvanáct je řada
 * navíc na mobilu i na desktopu, takže je jasné, že to pokračuje.
 */
const NAHLED = 12

/** Text o zásobě. Čeština má u jedničky jiný tvar než u dvojky. */
function stavZasoby(kusu: number, dochazi: boolean): string {
  if (kusu <= 0) return 'Vyprodáno'
  if (!dochazi) return `Skladem · ${kusu} ks`
  return kusu === 1 ? 'Zbývá 1 kus' : `Zbývají ${kusu} ks`
}

/**
 * Filtry kategorií se skládají z toho, co je v automatu právě teď —
 * nevypisují se ze Sanity. Kategorie určuje MůjAutomat a ručně
 * udržovaný seznam by po každé změně sortimentu lhal.
 *
 * V Sanity zůstávají jen filtry, které z dat neplynou: Vše,
 * Nejprodávanější a Poslední kusy.
 */
function odvodFiltry(zbozi: {kategorie: string}[]): string[] {
  return [...new Set(zbozi.map((p) => p.kategorie).filter(Boolean))].sort((a, b) =>
    a.localeCompare(b, 'cs'),
  )
}

const kategorie = odvodFiltry(produkty)

const polozky = produkty.map((p) => {
  const dochazi = p.dostupnost <= hranice
  const kapacita = p.kapacita && p.kapacita > 0 ? p.kapacita : 12
  return {
    ...p,
    dochazi,
    // Proužek dostupnosti. V prototypu byly šířky vymyšlené, tady se počítají
    // ze skutečné zásoby — proto se o pár procent liší.
    procento: Math.max(0, Math.min(100, Math.round((p.dostupnost / kapacita) * 100))),
    stav: stavZasoby(p.dostupnost, dochazi),
  }
})
---

<div class="offer reveal">
  <div class="prodhead">
    <h2>{obsah.nabidkaNadpis}</h2>
    {
      obsah.nabidkaStitek && (
        <span class="prodhead__stitek">
          <span class="livedot" />
          {obsah.nabidkaStitek}
        </span>
      )
    }
  </div>

  <div class="chips" id="chips" role="group" aria-label="Kategorie">
    <button class="chip" type="button" data-f="all" aria-pressed="true">Vše</button>
    {
      kategorie.map((k) => (
        <button class="chip" type="button" data-f={k} aria-pressed="false">
          {k}
        </button>
      ))
    }
    <button class="chip" type="button" data-f="top" aria-pressed="false">Nejprodávanější</button>
    <button class="chip" type="button" data-f="low" aria-pressed="false">Poslední kusy</button>
  </div>

  <div class="prodgrid" id="prodgrid" data-hranice={hranice}>
    {
      polozky.map((p, i) => (
        <div
          class="prod"
          hidden={i >= NAHLED}
          data-cat={p.kategorie}
          data-top={p.nejprodavanejsi ? '1' : undefined}
          data-low={p.dochazi ? '1' : undefined}
        >
          {p.nejprodavanejsi && !p.dochazi && <span class="prod__badge">Nejprodávanější</span>}
          {p.dochazi && <span class="prod__badge prod__badge--low">Poslední kusy</span>}
          <div class="prod__n">{p.nazev}</div>
          <div class="prod__p">{p.cena} Kč</div>
          <div class={`bar ${p.dochazi ? 'bar--low' : ''}`}>
            <span style={`width:${p.procento}%`} />
          </div>
          <div class="prod__s">{p.stav}</div>
        </div>
      ))
    }
  </div>

  {
    polozky.length > NAHLED && (
      <button class="offer__vic" type="button" id="vicebutton" data-nahled={NAHLED}>
        Zobrazit celou nabídku ({polozky.length} položek)
      </button>
    )
  }

  <p class="offer__pozn">
    <span id="fcount">Zobrazeno {Math.min(NAHLED, polozky.length)} z {polozky.length} položek</span>
    {obsah.nabidkaPoznamka && ` · ${obsah.nabidkaPoznamka}`}
    <span id="fnote"></span>
  </p>
</div>

<script>
  /**
   * Nabídka boxu. Server vykreslí poslední známý stav ze Sanity, aby
   * stránka nebyla prázdná a fungovala i bez JavaScriptu. Skript ji pak
   * přepíše živými daty z /api/automat.
   *
   * Když volání selže, na stránce zůstane to, co vykreslil server —
   * návštěvník o tom neví a nic nespadne.
   */
  const mrizka = document.getElementById('prodgrid')
  const pocitadlo = document.getElementById('fcount')
  const poznamka = document.getElementById('fnote')
  const filtry = document.getElementById('chips')
  const viceButton = document.getElementById('vicebutton')

  const HRANICE = Number(mrizka?.dataset.hranice ?? 3)
  const NAHLED = Number(viceButton?.dataset.nahled ?? 12)

  /** Rozbaleno zůstává rozbalené i po načtení živých dat. */
  let rozbaleno = false
  /** Vybraný filtr přežije překreslení mřížky. */
  let filtr = 'all'

  function stavZasoby(kusu, dochazi) {
    if (kusu <= 0) return 'Vyprodáno'
    if (!dochazi) return `Skladem · ${kusu} ks`
    return kusu === 1 ? 'Zbývá 1 kus' : `Zbývají ${kusu} ks`
  }

  function vykresli(polozky) {
    if (!mrizka) return
    mrizka.replaceChildren(
      ...polozky.map((p) => {
        const dochazi = p.dostupnost <= HRANICE
        const procento = Math.max(0, Math.min(100, Math.round((p.dostupnost / (p.kapacita || 12)) * 100)))

        const karta = document.createElement('div')
        karta.className = 'prod'
        karta.dataset.cat = p.kategorie
        if (p.nejprodavanejsi) karta.dataset.top = '1'
        if (dochazi) karta.dataset.low = '1'

        if (dochazi) {
          const odznak = document.createElement('span')
          odznak.className = 'prod__badge prod__badge--low'
          odznak.textContent = 'Poslední kusy'
          karta.append(odznak)
        } else if (p.nejprodavanejsi) {
          const odznak = document.createElement('span')
          odznak.className = 'prod__badge'
          odznak.textContent = 'Nejprodávanější'
          karta.append(odznak)
        }

        const nazev = document.createElement('div')
        nazev.className = 'prod__n'
        nazev.textContent = p.nazev

        const cena = document.createElement('div')
        cena.className = 'prod__p'
        cena.textContent = `${p.cena} Kč`

        const prouzek = document.createElement('div')
        prouzek.className = dochazi ? 'bar bar--low' : 'bar'
        const vypln = document.createElement('span')
        vypln.style.width = `${procento}%`
        prouzek.append(vypln)

        const stav = document.createElement('div')
        stav.className = 'prod__s'
        stav.textContent = stavZasoby(p.dostupnost, dochazi)

        karta.append(nazev, cena, prouzek, stav)
        return karta
      }),
    )
  }

  /**
   * Filtry se skládají z toho, co v automatu právě je. Kategorie určuje
   * MůjAutomat, takže ruční seznam by po každé změně sortimentu lhal.
   * Vše, Nejprodávanější a Poslední kusy z dat neplynou a zůstávají vždy.
   */
  function vykresliFiltry(polozky) {
    if (!filtry) return
    const kategorie = [...new Set(polozky.map((p) => p.kategorie).filter(Boolean))].sort((a, b) =>
      a.localeCompare(b, 'cs'),
    )

    const tlacitko = (hodnota, text) => {
      const b = document.createElement('button')
      b.className = 'chip'
      b.type = 'button'
      b.dataset.f = hodnota
      b.textContent = text
      b.setAttribute('aria-pressed', String(hodnota === filtr))
      return b
    }

    filtry.replaceChildren(
      tlacitko('all', 'Vše'),
      ...kategorie.map((k) => tlacitko(k, k)),
      tlacitko('top', 'Nejprodávanější'),
      tlacitko('low', 'Poslední kusy'),
    )
  }

  /**
   * Jediné místo, které rozhoduje o viditelnosti karty. Filtr a zkrácený
   * náhled se nesmí přebíjet — dřív si na atribut hidden sahaly obě
   * větve zvlášť a po přepnutí filtru se vynořily i skryté položky.
   */
  function prekresli() {
    if (!mrizka) return
    const vse = [...mrizka.querySelectorAll('.prod')]

    const sedi = vse.filter(
      (p) =>
        filtr === 'all' ||
        (filtr === 'top' && p.dataset.top) ||
        (filtr === 'low' && p.dataset.low) ||
        p.dataset.cat === filtr,
    )

    // Ve zkráceném náhledu se ořezává až vyfiltrovaný seznam, takže
    // i úzká kategorie ukáže svých dvanáct, ne zbytek z prvních dvanácti.
    const videt = rozbaleno ? sedi : sedi.slice(0, NAHLED)
    const viditelne = new Set(videt)
    vse.forEach((p) => {
      p.hidden = !viditelne.has(p)
    })

    if (pocitadlo) pocitadlo.textContent = `Zobrazeno ${videt.length} z ${vse.length} položek`

    if (viceButton) {
      // Tlačítko dává smysl jen tehdy, když je co rozbalovat.
      viceButton.hidden = sedi.length <= NAHLED
      viceButton.textContent = rozbaleno
        ? 'Zobrazit méně'
        : `Zobrazit celou nabídku (${sedi.length} položek)`
    }
  }

  filtry?.addEventListener('click', (e) => {
    const chip = e.target.closest('.chip')
    if (!chip) return
    filtr = chip.dataset.f
    filtry.querySelectorAll('.chip').forEach((x) => {
      x.setAttribute('aria-pressed', String(x === chip))
    })
    // Přepnutí filtru vrací náhled na zkrácený — jinak by zůstal
    // rozbalený z předchozí, širší kategorie.
    rozbaleno = false
    prekresli()
  })

  viceButton?.addEventListener('click', () => {
    rozbaleno = !rozbaleno
    prekresli()
  })

  prekresli()

  // --- živá data ---
  fetch('/api/automat', {headers: {accept: 'application/json'}})
    .then((r) => (r.ok ? r.json() : Promise.reject(new Error(String(r.status)))))
    .then((data) => {
      if (!Array.isArray(data.polozky) || data.polozky.length === 0) return
      vykresli(data.polozky)
      vykresliFiltry(data.polozky)
      prekresli()

      if (poznamka && data.zdroj === 'zaloha') {
        // Návštěvník má vědět, že čísla nemusí být aktuální.
        const cas = new Date(data.aktualizovano).toLocaleString('cs-CZ')
        poznamka.textContent = ` · Automat se právě neozývá, zobrazujeme poslední známý stav z ${cas}.`
      }
    })
    .catch(() => {
      // Zůstane to, co vykreslil server. Nic dalšího není potřeba.
    })
</script>
