---
import {obrazek, rozmery, srcset} from '../lib/sanity'
import Ikona from './Ikona.astro'
import type {SiteSettings} from '../lib/queries'

interface Props {
  nastaveni: SiteSettings
}

const {nastaveni} = Astro.props
const {
  logoInverzni,
  nazev,
  popisPaticky,
  adresa,
  telefon,
  email,
  ico,
  patickaSloupce = [],
  socialniSite = [],
} = nastaveni

// Telefon bez mezer, aby fungoval tel: odkaz.
const telefonOdkaz = telefon.replace(/\s+/g, '')
const rok = new Date().getFullYear()

/** Poměr stran inverzního loga — viz stejný výpočet v Navigace.astro. */
const VYSKA_LOGA = 52
const puvodni = logoInverzni ? rozmery(logoInverzni) : null
const sirkaLoga = puvodni ? Math.round((VYSKA_LOGA * puvodni.sirka) / puvodni.vyska) : undefined

/**
 * Právní řádek patičky: název, sídlo, IČO.
 *
 * Spisová značka se odsud přesunula na /kontakt mezi ostatní údaje
 * o společnosti. §435 občanského zákoníku ji na webu vyžaduje, ale
 * neurčuje kde — a v patičce dělala z jednoho řádku dva.
 *
 * Věta o tom, že nejsme plátci DPH, patří k cenám, ne pod každou
 * stránku. Je na /cenik.
 */
const pravniUdaje = [adresa.replace(/\n/g, ', '), `IČO ${ico}`].join(' · ')
---

<footer class="footer">
  <div class="container">
    <div class="footer__grid">
      <div>
        {
          logoInverzni && (
            <img
              src={obrazek(logoInverzni).height(52).url()}
              srcset={srcset(logoInverzni, [104, 156, 208])}
              sizes="104px"
              width={sirkaLoga}
              height={VYSKA_LOGA}
              alt={nazev}
            />
          )
        }
        {popisPaticky && <p class="footer__popis">{popisPaticky}</p>}
        {
          socialniSite.length > 0 && (
            <div class="socialni">
              {socialniSite.map((s) => (
                <a href={s.url} aria-label={s.sit} rel="me noopener" target="_blank">
                  <Ikona jmeno={s.sit.toLowerCase()} />
                </a>
              ))}
            </div>
          )
        }

        <div class="footcontact">
          <Fragment set:html={adresa.replace(/\n/g, '<br>')} />
          <br />
          <a href={`tel:${telefonOdkaz}`}>{telefon}</a>
          <br />
          <a href={`mailto:${email}`}>{email}</a>
        </div>
      </div>

      {
        patickaSloupce.map((sloupec) => (
          <div>
            <h3>{sloupec.nadpis}</h3>
            <ul>
              {sloupec.odkazy?.map((o) => (
                <li>
                  <a href={o.odkaz}>{o.text}</a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div class="footer__legal">
      <div>
        <strong style="color:rgba(255,255,255,.7)">{nazev}</strong> · {pravniUdaje}
      </div>
      <div>© {rok} {nazev} · Vytvořeno divizí <a href="/sluzby">Digital Services</a></div>
    </div>
  </div>
</footer>
