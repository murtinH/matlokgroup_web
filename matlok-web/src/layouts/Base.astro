---
/**
 * Základní layout. Jediné místo, kde se načítá globální CSS.
 * Obsah stránek se vkládá do <slot />.
 */
import '../styles/global.css';

interface Props {
  titulek: string;
  popis?: string;
}

const { titulek, popis } = Astro.props;
---

<!doctype html>
<html lang="cs">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Značková písma. Načítají se tady, ne v CSS — viz komentář
         v src/styles/tokens/fonts.css. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700;800;900&family=Inter:wght@400;500;600;700&display=swap"
    />
    <title>{titulek}</title>
    {popis && <meta name="description" content={popis} />}
  </head>
  <body>
    <slot />
  </body>
</html>
