---
/**
 * Základní layout. Jediné místo, kde se načítá globální CSS a písma.
 * Obsah stránek se vkládá do <slot />.
 */
import '../styles/global.css'
import '../styles/site.css'

// Značková písma jsou u nás, ne u Google Fonts — proč, viz
// src/styles/tokens/fonts.css. Jen řezy, které web opravdu používá:
// Montserrat 300 nikde není, ostatní ano (nadpisy 800–900, popisky 600–700).
// Každý řez má zvlášť latinku a latin-ext; prohlížeč stáhne jen to,
// co na stránce potřebuje.
import '@fontsource/montserrat/400.css'
import '@fontsource/montserrat/500.css'
import '@fontsource/montserrat/600.css'
import '@fontsource/montserrat/700.css'
import '@fontsource/montserrat/800.css'
import '@fontsource/montserrat/900.css'
import '@fontsource/inter/400.css'
import '@fontsource/inter/500.css'
import '@fontsource/inter/600.css'
import '@fontsource/inter/700.css'
import CookieLista from '../components/CookieLista.astro'
import {obrazek} from '../lib/sanity'
import type {SiteSettings} from '../lib/queries'

interface Props {
  /** Odvozený titulek. Ruční přepis ze Sanity má přednost. */
  titulek: string
  /** Odvozený popis, obvykle perex. Ruční přepis ze Sanity má přednost. */
  popis?: string
  /** Ruční přepis pro vyhledávače. Stačí předat celý dokument stránky. */
  seo?: {seoTitulek?: string; seoPopis?: string}
  /** Když je false, stránka se do vyhledávačů nedostane. */
  indexovat?: boolean
  /** Název tokenu podkladu bez uvozovek, například "azure-50".
      Každá stránka má podle zadání vlastní odstín. */
  pozadi?: string
  /** Kvůli cookie liště, která patří na každou stránku. */
  nastaveni: SiteSettings
}

const {titulek, popis, seo, indexovat = true, pozadi, nastaveni} = Astro.props

/**
 * Zkrácení popisu pro vyhledávače.
 *
 * Google ukazuje ve výsledku zhruba 155 znaků a delší text uřízne uprostřed
 * slova. Perexy na webu mají 156 až 262 znaků, takže se bez zkrácení
 * nevejde ani jeden. Řeže se na hranici slova a odsekává koncová
 * interpunkce, ať za tečkou nestojí ještě tři tečky.
 *
 * Je to záchranná síť, ne cíl. Dobrý popis se píše do pole „Popis pro
 * vyhledávače" v Sanity — perex prodává stránku návštěvníkovi, ne
 * vyhledávači, a zkrácený je skoro vždy horší než napsaný.
 */
function zkrat(text: string, limit = 155): string {
  const radek = text.replace(/\s+/g, ' ').trim()
  if (radek.length <= limit) return radek
  const rez = radek.slice(0, limit + 1)
  const mezera = rez.lastIndexOf(' ')
  return `${radek.slice(0, mezera > 0 ? mezera : limit).replace(/[.,;:–—-]+$/, '')}…`
}

const nadpisStranky = seo?.seoTitulek?.trim() || titulek
const popisZeSanity = seo?.seoPopis?.trim()
const popisStranky = popisZeSanity || (popis ? zkrat(popis) : undefined)

// Připomínka při buildu, ne chyba — web se kvůli chybějícímu popisu
// stavět nepřestane.
if (import.meta.env.PROD && !popisZeSanity && popis && popis.length > 165) {
  console.warn(
    `[SEO] ${Astro.url.pathname}: popis se bere z perexu (${popis.length} znaků) a musel se zkrátit. ` +
      'Doplňte pole „Popis pro vyhledávače" v Sanity.',
  )
}

/** Kanonická adresa — bez lomítka na konci, aby odpovídala odkazům na webu. */
const kanonicka = new URL(Astro.url.pathname.replace(/\/$/, '') || '/', Astro.site).href

/** Obrázek, který se ukáže při sdílení odkazu. */
const sdileni = nastaveni.ogObrazek
  ? obrazek(nastaveni.ogObrazek).width(1200).height(630).fit('crop').url()
  : null
---

<!doctype html>
<html lang="cs">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- SVG má tmavý podklad, aby byl bílý monogram vidět i na světlém
         panelu prohlížeče. PNG zůstává pro prohlížeče, které SVG neumí. -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" type="image/png" href="/favicon.png" />

    <!-- Obrázky se stahují ze Sanity CDN. Navázání spojení dopředu ušetří
         u prvního obrázku jeden DNS a TLS round trip. -->
    <link rel="preconnect" href="https://cdn.sanity.io" crossorigin />

    <title>{nadpisStranky}</title>
    {popisStranky && <meta name="description" content={popisStranky} />}
    <link rel="canonical" href={kanonicka} />

    <!-- max-image-preview:large pouští Googlu velký náhled u obrázkových
         výsledků a v Discoveru; bez toho dostaneme miniaturu. -->
    <meta
      name="robots"
      content={indexovat ? 'index, follow, max-image-preview:large' : 'noindex, follow'}
    />

    <!-- Náhled, který se ukáže při sdílení odkazu na sociální síti
         nebo v chatu. Bez těchhle značek si sítě vyberou samy —
         obvykle první obrázek na stránce a kus textu odnikud. -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={nastaveni.nazev} />
    <meta property="og:locale" content="cs_CZ" />
    <meta property="og:title" content={nadpisStranky} />
    <meta property="og:url" content={kanonicka} />
    {popisStranky && <meta property="og:description" content={popisStranky} />}
    {
      sdileni && (
        <Fragment>
          <meta property="og:image" content={sdileni} />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta property="og:image:alt" content={nastaveni.nazev} />
        </Fragment>
      )
    }
    <meta name="twitter:card" content={sdileni ? 'summary_large_image' : 'summary'} />

    <!-- Bez JavaScriptu se nájezdy sekcí vůbec nezapnou a obsah je rovnou
         vidět. Třída se přidává tady, aby nedošlo k probliknutí. -->
    <script is:inline>
      document.documentElement.classList.add('js')
    </script>
  </head>
  <body style={pozadi ? `--page-bg: var(--${pozadi})` : undefined}>
    <slot />

    <CookieLista nastaveni={nastaveni} />

    <script>
      /**
       * Živé údaje z automatu. Prvky označené data-zdroj dostanou hodnotu
       * z /api/automat — počet produktů v nabídce a počet prodaných kusů.
       * Ručně zadaná hodnota v Sanity zůstává jako záloha; když volání
       * selže nebo na stránce žádný takový prvek není, nic se nestane.
       *
       * Běží před počítadly, aby se odpočítávalo už k živému číslu.
       */
      const zive = document.querySelectorAll<HTMLElement>('[data-zdroj]')

      if (zive.length > 0) {
        // Prohlížeč se musí pokaždé zeptat serveru. Cloudflare u téhle
        // odpovědi hlásil max-age až čtyři hodiny a vracejícímu se
        // návštěvníkovi by zásoby i počet prodaných kusů stály.
        fetch('/api/automat', {cache: 'no-cache', headers: {accept: 'application/json'}})
          .then((r) => (r.ok ? r.json() : Promise.reject(new Error(String(r.status)))))
          .then((data: {polozky?: unknown[]; prodano?: number | null}) => {
            const polozky = data.polozky ?? []
            if (polozky.length === 0) return

            const hodnoty: Record<string, string> = {
              pocet: String(polozky.length),
            }

            /*
             * Prodané kusy umí spočítat jen API a ze Sanity se nedopočítají.
             * Když se číslo nepodaří zjistit, napíše se pomlčka — dlaždice
             * přizná, že hodnotu nezná. Ručně zadané číslo by tvrdilo něco,
             * co nikdo neověřil, a nula by lhala, že se neprodalo nic.
             */
            hodnoty.prodano =
              typeof data.prodano === 'number' ? data.prodano.toLocaleString('cs-CZ') : '—'

            zive.forEach((prvek) => {
              const klic = prvek.dataset.zdroj
              if (klic && hodnoty[klic]) prvek.textContent = hodnoty[klic]
            })
          })
          .catch(() => {
            // Zůstane hodnota ze Sanity. Návštěvník nic nepozná.
          })
      }
    </script>

    <script>
      /**
       * Počítadla. Čísla na stránce naskočí od nuly, jakmile se dostanou
       * do zorného pole. Animuje se jen řetězec, který obsahuje právě
       * jedno číslo — "99 %" ano, "24/7" ne, protože obsahuje dvě.
       *
       * Mezera po tisících se za oddělovač čísel nepočítá: "1 234 kusů"
       * je jedno číslo. Bez toho by se počítadlo u čtyřciferných hodnot
       * vůbec nespustilo — a přesně tam patří počet prodaných kusů.
       *
       * Tři sekundy jsou násobně víc, než CLAUDE.md povoluje u animací.
       * To pravidlo míří na přechody rozhraní, kde delší doba působí
       * jako zadrhnutí; tohle je odkrytí obsahu, ne přechod.
       *
       * Delší už ne. Po celou dobu běhu ukazuje karta číslo, které není
       * pravda — kdo stránku přelétne za pár vteřin, odejde s tím, že
       * v automatu je dvanáct produktů místo devětatřiceti.
       */
      const POCITADLA = '.stat__num, .kpi__v, .kpitile__v'
      const TRVANI = 3000

      const tlumit = window.matchMedia('(prefers-reduced-motion: reduce)').matches

      /** Mezery, kterými se v češtině oddělují tisíce. */
      const MEZERY = /[\s\u00A0\u202F]/

      function rozlozCislo(text: string) {
        const cisla = text.match(/\d+(?:[\s\u00A0\u202F]\d{3})*/g)
        if (!cisla || cisla.length !== 1) return null
        const cele = cisla[0]
        const [pred, po] = text.split(cele)
        return {
          pred,
          cil: Number(cele.replace(new RegExp(MEZERY.source, 'g'), '')),
          po,
          // Oddělovač se přebírá z původního textu, ať se formát v půlce
          // animace nezmění.
          oddelovac: cele.match(MEZERY)?.[0] ?? '',
        }
      }

      function odpocitej(prvek: HTMLElement) {
        const rozklad = rozlozCislo(prvek.textContent ?? '')
        if (!rozklad) return
        const {pred, cil, po, oddelovac} = rozklad
        const start = performance.now()

        const krok = (ted: number) => {
          const podil = Math.min(1, (ted - start) / TRVANI)
          // Zpomalení ke konci, ať čísla nedojedou naráz.
          const hodnota = Math.round(cil * (1 - Math.pow(1 - podil, 3)))
          const zapis = oddelovac
            ? hodnota.toLocaleString('cs-CZ').replace(new RegExp(MEZERY.source, 'g'), oddelovac)
            : String(hodnota)
          prvek.textContent = `${pred}${zapis}${po}`
          if (podil < 1) requestAnimationFrame(krok)
        }
        requestAnimationFrame(krok)
      }

      if (!tlumit && 'IntersectionObserver' in window) {
        const sledovac = new IntersectionObserver(
          (zaznamy) =>
            zaznamy.forEach((z) => {
              if (z.isIntersecting) {
                sledovac.unobserve(z.target)
                odpocitej(z.target as HTMLElement)
              }
            }),
          {threshold: 0.6},
        )
        document.querySelectorAll<HTMLElement>(POCITADLA).forEach((p) => sledovac.observe(p))
      }
    </script>

    <script>
      const prvky = document.querySelectorAll('.reveal')
      const tlumit = window.matchMedia('(prefers-reduced-motion: reduce)').matches

      if (tlumit || !('IntersectionObserver' in window)) {
        prvky.forEach((el) => el.classList.add('in'))
      } else {
        const io = new IntersectionObserver(
          (zaznamy) =>
            zaznamy.forEach((z) => {
              if (z.isIntersecting) {
                z.target.classList.add('in')
                io.unobserve(z.target)
              }
            }),
          {threshold: 0.1},
        )
        prvky.forEach((el, i) => {
          ;(el as HTMLElement).style.transitionDelay = `${(i % 3) * 70}ms`
          io.observe(el)
        })
      }
    </script>
  </body>
</html>
