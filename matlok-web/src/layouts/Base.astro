---
/**
 * Základní layout. Jediné místo, kde se načítá globální CSS a písma.
 * Obsah stránek se vkládá do <slot />.
 */
import '../styles/global.css'
import '../styles/site.css'
import CookieLista from '../components/CookieLista.astro'
import {obrazek} from '../lib/sanity'
import type {SiteSettings} from '../lib/queries'

interface Props {
  titulek: string
  popis?: string
  /** Název tokenu podkladu bez uvozovek, například "azure-50".
      Každá stránka má podle zadání vlastní odstín. */
  pozadi?: string
  /** Kvůli cookie liště, která patří na každou stránku. */
  nastaveni: SiteSettings
}

const {titulek, popis, pozadi, nastaveni} = Astro.props

/** Kanonická adresa — bez lomítka na konci, aby odpovídala odkazům na webu. */
const kanonicka = new URL(Astro.url.pathname.replace(/\/$/, '') || '/', Astro.site).href

/** Obrázek, který se ukáže při sdílení odkazu. */
const sdileni = nastaveni.ogObrazek
  ? obrazek(nastaveni.ogObrazek).width(1200).height(630).fit('crop').url()
  : null
---

<!doctype html>
<html lang="cs">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- SVG má tmavý podklad, aby byl bílý monogram vidět i na světlém
         panelu prohlížeče. PNG zůstává pro prohlížeče, které SVG neumí. -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" type="image/png" href="/favicon.png" />

    <!-- Značková písma. Načítají se tady, ne v CSS — viz komentář
         v src/styles/tokens/fonts.css. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700;800;900&family=Inter:wght@400;500;600;700&display=swap"
    />

    <title>{titulek}</title>
    {popis && <meta name="description" content={popis} />}
    <link rel="canonical" href={kanonicka} />

    <!-- Náhled, který se ukáže při sdílení odkazu na sociální síti
         nebo v chatu. Bez těchhle značek si sítě vyberou samy —
         obvykle první obrázek na stránce a kus textu odnikud. -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={nastaveni.nazev} />
    <meta property="og:locale" content="cs_CZ" />
    <meta property="og:title" content={titulek} />
    <meta property="og:url" content={kanonicka} />
    {popis && <meta property="og:description" content={popis} />}
    {
      sdileni && (
        <Fragment>
          <meta property="og:image" content={sdileni} />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta property="og:image:alt" content={nastaveni.nazev} />
        </Fragment>
      )
    }
    <meta name="twitter:card" content={sdileni ? 'summary_large_image' : 'summary'} />

    <!-- Bez JavaScriptu se nájezdy sekcí vůbec nezapnou a obsah je rovnou
         vidět. Třída se přidává tady, aby nedošlo k probliknutí. -->
    <script is:inline>
      document.documentElement.classList.add('js')
    </script>
  </head>
  <body style={pozadi ? `--page-bg: var(--${pozadi})` : undefined}>
    <slot />

    <CookieLista nastaveni={nastaveni} />

    <script>
      /**
       * Živé údaje z automatu. Prvky označené data-zdroj dostanou hodnotu
       * z /api/automat — počet produktů v nabídce a dostupnost. Ručně
       * zadaná hodnota v Sanity zůstává jako záloha; když volání selže
       * nebo na stránce žádný takový prvek není, nic se nestane.
       *
       * Běží před počítadly, aby se odpočítávalo už k živému číslu.
       */
      const zive = document.querySelectorAll<HTMLElement>('[data-zdroj]')

      if (zive.length > 0) {
        fetch('/api/automat', {headers: {accept: 'application/json'}})
          .then((r) => (r.ok ? r.json() : Promise.reject(new Error(String(r.status)))))
          .then((data: {polozky?: {dostupnost: number; kapacita: number}[]}) => {
            const polozky = data.polozky ?? []
            if (polozky.length === 0) return

            const zasoba = polozky.reduce((s, p) => s + p.dostupnost, 0)
            const kapacita = polozky.reduce((s, p) => s + (p.kapacita || 12), 0)

            const hodnoty: Record<string, string> = {
              pocet: String(polozky.length),
              dostupnost: `${Math.round((zasoba / Math.max(1, kapacita)) * 100)} %`,
            }

            zive.forEach((prvek) => {
              const klic = prvek.dataset.zdroj
              if (klic && hodnoty[klic]) prvek.textContent = hodnoty[klic]
            })
          })
          .catch(() => {
            // Zůstane hodnota ze Sanity. Návštěvník nic nepozná.
          })
      }
    </script>

    <script>
      /**
       * Počítadla. Čísla na stránce naskočí od nuly, jakmile se dostanou
       * do zorného pole. Animuje se jen řetězec, který obsahuje právě
       * jedno číslo — "99 %" ano, "24/7" ne, protože obsahuje dvě.
       *
       * Tři sekundy jsou násobně víc, než CLAUDE.md povoluje u animací.
       * To pravidlo míří na přechody rozhraní, kde delší doba působí
       * jako zadrhnutí; tohle je odkrytí obsahu, ne přechod.
       *
       * Delší už ne. Po celou dobu běhu ukazuje karta číslo, které není
       * pravda — kdo stránku přelétne za pár vteřin, odejde s tím, že
       * v automatu je dvanáct produktů místo devětatřiceti.
       */
      const POCITADLA = '.stat__num, .kpi__v, .kpitile__v, .sfact b'
      const TRVANI = 3000

      const tlumit = window.matchMedia('(prefers-reduced-motion: reduce)').matches

      function rozlozCislo(text: string) {
        const cisla = text.match(/\d+/g)
        if (!cisla || cisla.length !== 1) return null
        const [pred, po] = text.split(cisla[0])
        return {pred, cil: Number(cisla[0]), po}
      }

      function odpocitej(prvek: HTMLElement) {
        const rozklad = rozlozCislo(prvek.textContent ?? '')
        if (!rozklad) return
        const {pred, cil, po} = rozklad
        const start = performance.now()

        const krok = (ted: number) => {
          const podil = Math.min(1, (ted - start) / TRVANI)
          // Zpomalení ke konci, ať čísla nedojedou naráz.
          const hodnota = Math.round(cil * (1 - Math.pow(1 - podil, 3)))
          prvek.textContent = `${pred}${hodnota}${po}`
          if (podil < 1) requestAnimationFrame(krok)
        }
        requestAnimationFrame(krok)
      }

      if (!tlumit && 'IntersectionObserver' in window) {
        const sledovac = new IntersectionObserver(
          (zaznamy) =>
            zaznamy.forEach((z) => {
              if (z.isIntersecting) {
                sledovac.unobserve(z.target)
                odpocitej(z.target as HTMLElement)
              }
            }),
          {threshold: 0.6},
        )
        document.querySelectorAll<HTMLElement>(POCITADLA).forEach((p) => sledovac.observe(p))
      }
    </script>

    <script>
      const prvky = document.querySelectorAll('.reveal')
      const tlumit = window.matchMedia('(prefers-reduced-motion: reduce)').matches

      if (tlumit || !('IntersectionObserver' in window)) {
        prvky.forEach((el) => el.classList.add('in'))
      } else {
        const io = new IntersectionObserver(
          (zaznamy) =>
            zaznamy.forEach((z) => {
              if (z.isIntersecting) {
                z.target.classList.add('in')
                io.unobserve(z.target)
              }
            }),
          {threshold: 0.1},
        )
        prvky.forEach((el, i) => {
          ;(el as HTMLElement).style.transitionDelay = `${(i % 3) * 70}ms`
          io.observe(el)
        })
      }
    </script>
  </body>
</html>
