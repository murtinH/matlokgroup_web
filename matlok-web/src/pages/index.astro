---
import Base from '../layouts/Base.astro'
import Navigace from '../components/Navigace.astro'
import Paticka from '../components/Paticka.astro'
import Hero from '../components/Hero.astro'
import Pas from '../components/Pas.astro'
import KartaDivize from '../components/KartaDivize.astro'
import PasZakladatele from '../components/PasZakladatele.astro'
import Ikona from '../components/Ikona.astro'
import StrukturovanaData from '../components/StrukturovanaData.astro'
import {nastaveni, domovskaStranka, divize, zakladatele} from '../lib/queries'

const [site, obsah, seznamDivizi, seznamZakladatelu] = await Promise.all([
  nastaveni(),
  domovskaStranka(),
  divize(),
  zakladatele(),
])

---

<Base nastaveni={site}
  titulek={`${site.nazev} — ${obsah.heroNadpis} ${obsah.heroNadpisTip}`}
  popis={obsah.heroLead}
  seo={obsah}
>
  <Navigace nastaveni={site} aktivni="/" />

  <main>
    <Hero obsah={obsah} />
    <Pas polozky={obsah.pas ?? []} />

    <section class="section" id="divize">
      <div class="container">
        <div class="sechead reveal">
          <p class="eyebrow">{obsah.divizeEyebrow}</p>
          <h2>{obsah.divizeNadpis}</h2>
          <p class="lead">{obsah.divizeLead}</p>
        </div>
        <div class="divgrid">
          {seznamDivizi.map((d) => <KartaDivize divize={d} />)}
        </div>
      </div>
    </section>

    <section class="section" id="zakladatele" style="background: var(--neutral-0)">
      <div class="container">
        <div class="sechead reveal">
          <p class="eyebrow">{obsah.zakladateleEyebrow}</p>
          <h2>
            {obsah.zakladateleNadpis}<br /><span class="tip">{obsah.zakladateleNadpisTip}</span>
          </h2>
          <p class="lead">{obsah.zakladateleLead}</p>
        </div>

        <div class="zakladatele">
          {seznamZakladatelu.map((z) => <PasZakladatele zakladatel={z} />)}
        </div>

        {
          obsah.vize && (
            <div class="vision reveal">
              <h3>{obsah.vize.nadpis}</h3>
              <p>{obsah.vize.text}</p>
            </div>
          )
        }
      </div>
    </section>

    <section class="section" style="background: var(--snow)">
      <div class="container">
        <div class="sechead reveal">
          <p class="eyebrow">{obsah.procEyebrow}</p>
          <h2>{obsah.procNadpis}</h2>
        </div>
        <div class="why">
          {
            obsah.duvody?.map((d) => (
              <div class="whycard reveal">
                <div class="why__ic">{d.ikona && <Ikona jmeno={d.ikona} />}</div>
                <h3>{d.nadpis}</h3>
                <p>{d.text}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>
  </main>

  <Paticka nastaveni={site} />

  <StrukturovanaData nastaveni={site} />
</Base>
