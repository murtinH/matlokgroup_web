---
import Base from '../layouts/Base.astro'
import Navigace from '../components/Navigace.astro'
import Paticka from '../components/Paticka.astro'
import Ikona from '../components/Ikona.astro'
import NabidkaBoxu from '../components/NabidkaBoxu.astro'
import IlustraceBoxu from '../components/IlustraceBoxu.astro'
import StrukturovanaData from '../components/StrukturovanaData.astro'
import {drobecky} from '../lib/drobecky'
import {nastaveni, strankaMatlok, produkty, automat, type Product} from '../lib/queries'

/**
 * Nabídka pro první vykreslení stránky.
 *
 * Bere se z produkčního /api/automat v okamžiku buildu — skutečné zboží
 * a kategorie. Skript v NabidkaBoxu ji po načtení přepíše živými daty,
 * ale do té doby (a návštěvníkům bez JavaScriptu) se dřív ukazovalo šest
 * ukázkových produktů z prototypu, které v automatu nikdy nebyly.
 *
 * Když produkce neodpoví do pěti vteřin, build nečeká a vezme produkty
 * ze Sanity. Web se kvůli cizí službě stavět nepřestane.
 */
async function nabidkaPriBuildu(): Promise<Product[]> {
  try {
    const odpoved = await fetch(new URL('/api/automat', Astro.site), {
      signal: AbortSignal.timeout(5000),
      headers: {accept: 'application/json'},
    })
    if (!odpoved.ok) throw new Error(`HTTP ${odpoved.status}`)
    const data = (await odpoved.json()) as {polozky?: Product[]}
    if (data.polozky?.length) return data.polozky
    throw new Error('prázdná nabídka')
  } catch (chyba) {
    console.warn('[matlok] Nabídka z produkce při buildu nedostupná, beru produkty ze Sanity:', chyba)
    return produkty()
  }
}

const [site, obsah, nabidka, box] = await Promise.all([
  nastaveni(),
  strankaMatlok(),
  nabidkaPriBuildu(),
  automat(),
])

const zaklad = (Astro.site?.href ?? 'https://matlok.cz/').replace(/\/$/, '')

const NAZVY_PLATEB: Record<string, string> = {
  karta: 'Platební karta',
  telefon: 'Platba telefonem',
  qr: 'QR kód',
}

/**
 * Prodejní box jako Store — podtyp LocalBusiness. Vydá se jen tehdy, když
 * je v Sanity vyplněná GPS. Obchodní zápis bez ověřitelného místa je podle
 * pravidel Google zavádějící údaj, ne užitečná informace; souřadnice jsou
 * zatím otevřený bod v ZADANI.md. Jakmile je někdo doplní, uzel se objeví
 * sám a v kódu se nic měnit nemusí.
 *
 * Jednotlivé produkty se do dat nedávají. Sortiment i zásoby se mění
 * z cizího API a objednat se online nedají — nabídka na zboží, které si
 * návštěvník nemůže koupit, je přesně to, co Google trestá.
 */
const prodejna = box?.gps
  ? {
      '@type': 'Store',
      '@id': `${zaklad}/matlok#box`,
      name: box.nazev,
      url: `${zaklad}/matlok`,
      parentOrganization: {'@id': `${zaklad}/#organizace`},
      address: {'@type': 'PostalAddress', addressLocality: box.lokalita, addressCountry: 'CZ'},
      geo: {'@type': 'GeoCoordinates', latitude: box.gps.lat, longitude: box.gps.lng},
      // 24/7 se zapisuje jako všech sedm dnů od půlnoci do půlnoci.
      ...(box.oteviraciDoba === '24/7'
        ? {
            openingHoursSpecification: [
              {
                '@type': 'OpeningHoursSpecification',
                dayOfWeek: [
                  'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday',
                ],
                opens: '00:00',
                closes: '23:59',
              },
            ],
          }
        : {}),
      ...(box.platby?.length
        ? {paymentAccepted: box.platby.map((p) => NAZVY_PLATEB[p]).filter(Boolean).join(', ')}
        : {}),
      currenciesAccepted: 'CZK',
    }
  : null

const uzly = [drobecky(zaklad, [{nazev: 'Matlok', cesta: '/matlok'}]), prodejna]
---

<Base nastaveni={site}
  titulek={`Matlok — ${obsah.heroNadpis} ${obsah.heroNadpisTip}`}
  popis={obsah.heroLead}
  seo={obsah}
  pozadi="azure-50"
>
  <Navigace nastaveni={site} aktivni="/matlok" />

  <main>
    <section class="phero">
      <div class="container">
        <div class="phero__grid">
          <div class="phero__uvod">
            <p class="eyebrow">{obsah.heroEyebrow}</p>
            <h1>{obsah.heroNadpis}<br /><span class="tip">{obsah.heroNadpisTip}</span></h1>
            <p class="lead">{obsah.heroLead}</p>
            {
              obsah.heroTlacitka && obsah.heroTlacitka.length > 0 && (
                <div class="ctas">
                  {obsah.heroTlacitka.map((t, i) => (
                    <a class={`btn ${i === 0 ? 'btn--primary' : 'btn--ghost'}`} href={t.odkaz}>
                      {t.text}
                    </a>
                  ))}
                </div>
              )
            }
          </div>

          <div class="photowrap">
            <IlustraceBoxu />
            {
              obsah.fotoPopisek && (
                <div class="photowrap__tag">
                  <span class="livedot" />
                  {obsah.fotoPopisek}
                </div>
              )
            }
          </div>
        </div>

        {
          obsah.kpi && obsah.kpi.length > 0 && (
            <div class="kpirow reveal">
              {obsah.kpi.map((d) => (
                <div class="kpitile">
                  <div class="kpitile__v" data-zdroj={d.zdroj}>{d.hodnota}</div>
                  <div class="kpitile__l">{d.popisek}</div>
                </div>
              ))}
            </div>
          )
        }
      </div>
    </section>

    <section class="section" id="nabidka" style="padding-top: 0">
      <div class="container">
        <NabidkaBoxu obsah={obsah} produkty={nabidka} />

        {
          obsah.vyhody && obsah.vyhody.length > 0 && (
            <div class="howto">
              {obsah.vyhody.map((v) => (
                <div class="reveal">
                  <div class="ben__ic">{v.ikona && <Ikona jmeno={v.ikona} />}</div>
                  <h3>{v.nadpis}</h3>
                  <p>{v.text}</p>
                </div>
              ))}
            </div>
          )
        }
      </div>
    </section>

    <section class="section" style="padding-top: 0">
      <div class="container">
        <div class="vyzva reveal">
          <div>
            <p class="eyebrow eyebrow--onink">{obsah.ctaEyebrow}</p>
            <h2>{obsah.ctaNadpis}</h2>
            <p>{obsah.ctaLead}</p>
          </div>
          <div class="vyzva__akce">
            {obsah.ctaTlacitko && <a class="btn btn--primary" href={obsah.ctaTlacitko.odkaz}>{obsah.ctaTlacitko.text}</a>}
          </div>
        </div>
      </div>
    </section>
  </main>

  <Paticka nastaveni={site} />

  <StrukturovanaData nastaveni={site} uzly={uzly} />
</Base>
