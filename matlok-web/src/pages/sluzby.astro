---
import Base from '../layouts/Base.astro'
import Navigace from '../components/Navigace.astro'
import Paticka from '../components/Paticka.astro'
import Ikona from '../components/Ikona.astro'
import StrukturovanaData from '../components/StrukturovanaData.astro'
import {drobecky} from '../lib/drobecky'
import {nastaveni, strankaSluzby, sluzby, principy} from '../lib/queries'

const [site, obsah, seznamSluzeb, seznamPrincipu] = await Promise.all([
  nastaveni(),
  strankaSluzby(),
  sluzby(),
  principy(),
])

const zaklad = (Astro.site?.href ?? 'https://matlok.cz/').replace(/\/$/, '')
const uzly = [drobecky(zaklad, [{nazev: 'Digital Services', cesta: '/sluzby'}])]

/** Čísla principů i kroků procesu se odvozují z pořadí, nepíšou se do Sanity. */
const cislo = (i: number) => String(i + 1).padStart(2, '0')
---

<Base nastaveni={site}
  titulek={`Digital Services — ${obsah.heroNadpis} ${obsah.heroNadpisTip}`}
  popis={obsah.heroLead}
  seo={obsah}
  pozadi="neutral-100"
>
  <Navigace nastaveni={site} aktivni="/sluzby" />

  <main>
    <section class="phero">
      <div class="container">
        <div class="phero__uvod" style="max-width: 70ch">
          <p class="eyebrow">{obsah.heroEyebrow}</p>
          <h1>{obsah.heroNadpis}<br /><span class="tip">{obsah.heroNadpisTip}</span></h1>
          <p class="lead">{obsah.heroLead}</p>
        </div>

        {/*
          Důkaz místo slibu hned pod úvodem, ne až na konci stránky.
          Dřív to byl tmavý box a hned pod ním další tmavý box s výzvou —
          dvě stejné plochy nad sebou. Tady je to světlý pruh se čtyřmi
          fakty, stejný vzor jako dlaždice na /matlok.
        */}
        {
          (obsah.vzorekNadpis || obsah.vzorekFakta?.length) && (
            <div class="dukaz reveal">
              <div class="dukaz__text">
                <p class="eyebrow">{obsah.vzorekEyebrow}</p>
                <h2>{obsah.vzorekNadpis}</h2>
                <p>{obsah.vzorekText}</p>
              </div>
              {obsah.vzorekFakta && obsah.vzorekFakta.length > 0 && (
                <div class="kpirow">
                  {obsah.vzorekFakta.map((f) => (
                    <div class="kpitile">
                      <div class="kpitile__v">{f.hodnota}</div>
                      <div class="kpitile__l">{f.popisek}</div>
                    </div>
                  ))}
                </div>
              )}
            </div>
          )
        }
      </div>
    </section>

    <section class="section" style="padding-top: var(--space-8)">
      <div class="container">
        <div class="sechead reveal">
          <p class="eyebrow">{obsah.filozofieEyebrow}</p>
          <h2>{obsah.filozofieNadpis}</h2>
          <p class="lead">{obsah.filozofieLead}</p>
        </div>
        <div class="principles">
          {
            seznamPrincipu.map((p, i) => (
              <article class="principle reveal">
                <div class="principle__n">{cislo(i)}</div>
                <h3>{p.nadpis}</h3>
                <p>{p.text}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section" style="background: var(--neutral-0)">
      <div class="container">
        <div class="sechead reveal">
          <p class="eyebrow">{obsah.sluzbyEyebrow}</p>
          <h2>{obsah.sluzbyNadpis}</h2>
        </div>

        <div class="svcgrid">
          {
            seznamSluzeb.map((s) => (
              <article class="svc reveal">
                <div class="svc__ic">{s.ikona && <Ikona jmeno={s.ikona} />}</div>
                <h3>{s.nazev}</h3>
                <p>{s.popis}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    {/*
      Jak to stavíme — samostatná sekce, ne patka sekce Služby.
      Původně to byl proužek bez nadpisu, bez karet a bez nadpisové
      semantiky; vedle Filozofie a Služeb vypadal jako poznámka pod čarou.
    */}
    <section class="section" id="proces">
      <div class="container">
        <div class="sechead reveal">
          <p class="eyebrow">{obsah.procesEyebrow}</p>
          <h2>{obsah.procesNadpis}</h2>
          {obsah.procesLead && <p class="lead">{obsah.procesLead}</p>}
        </div>

        {
          obsah.proces && obsah.proces.length > 0 && (
            <div class="kroky">
              {obsah.proces.map((krok, i) => (
                <article class="krok reveal">
                  <div class="krok__n">{cislo(i)}</div>
                  <h3>{krok.nadpis}</h3>
                  <p>{krok.popis}</p>
                </article>
              ))}
            </div>
          )
        }
      </div>
    </section>

    <section class="section" style="background: var(--neutral-0)">
      <div class="container">
        <div class="vyzva reveal">
          <div>
            <p class="eyebrow eyebrow--onink">{obsah.ctaEyebrow}</p>
            <h2>{obsah.ctaNadpis}</h2>
            <p>{obsah.ctaLead}</p>
          </div>
          <div class="vyzva__akce">
            {obsah.ctaTlacitko && <a class="btn btn--primary" href={obsah.ctaTlacitko.odkaz}>{obsah.ctaTlacitko.text}</a>}
          </div>
        </div>
      </div>
    </section>
  </main>

  <Paticka nastaveni={site} />

  <StrukturovanaData nastaveni={site} uzly={uzly} />
</Base>
