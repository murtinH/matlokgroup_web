{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "matlokgroup-web",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-08",

  // Výstup Astro buildu. Cloudflare soubory servíruje sám a skript
  // v worker/index.ts spustí až u adres, pro které soubor neexistuje.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",

    // Odkazy na webu jsou bez lomítka na konci (/matlok, ne /matlok/).
    // Výchozí chování Cloudflare je opačné a každý proklik by dělal
    // přesměrování navíc.
    "html_handling": "drop-trailing-slash"
  },

  // Počítadlo odeslání formuláře. Drží otisk IP a po hodině se sám smaže.
  // ID není tajné, je to jen identifikátor úložiště.
  "kv_namespaces": [
    {
      "binding": "RATE_LIMIT",
      "id": "061f52eff4684c98bbcb030d7fb87013"
    },

    // Poslední úspěšná nabídka z MůjAutomatu — záloha pro výpadek API.
    // Stejné úložiště jako počítadlo, jen jiný klíč (nabidka:posledni:v…);
    // počítadlo používá otisky IP, takže se klíče nepletou. Samostatné
    // úložiště by znamenalo zakládat další v dashboardu kvůli jednomu klíči.
    {
      "binding": "ZALOHA_NABIDKY",
      "id": "061f52eff4684c98bbcb030d7fb87013"
    },

    // Paměť hlídání automatu — co už bylo nahlášené a za který týden
    // odešel report. Opět stejné úložiště, klíče začínají provoz:.
    {
      "binding": "PROVOZ",
      "id": "061f52eff4684c98bbcb030d7fb87013"
    }
  ],

  // Plánované úlohy, čas v UTC. Každých 30 minut hlídání zásob a dostupnosti
  // automatu; týdenní report odchází ve stejném běhu, jakmile je na řadě.
  // Noční klid a pondělí řeší worker/provoz.ts podle pražského času.
  "triggers": {
    "crons": ["*/30 * * * *"]
  }

  // Veřejné identifikátory Sanity nejsou ani tady, ani v dashboardu —
  // jsou v src/lib/konfigurace.ts, odkud je čte build webu i tenhle skript.
  // Proměnné z "vars" totiž platí jen za běhu, ne při buildu.
  //
  // SANITY_WRITE_TOKEN a RESEND_API_KEY sem NEPATŘÍ. Vkládají se
  // v Cloudflare jako šifrované proměnné (Settings → Variables and Secrets).
}
